{
  "name": "dsh-side-chat-slash",
  "version": "0.1.0",
  "description": "Side chat for the DSH Web GUI with a /side slash command. Fork of @flyer103/dsh-side-chat 0.7.0: adds a host /side command, an open-request bridge, and approval pinned to never.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "side-chat",
    "side-conversation",
    "slash-command",
    "fork"
  ],
  "license": "MIT",
  "author": {
    "name": "lucyVan",
    "url": "https://github.com/lucyVan"
  },
  "homepage": "https://github.com/lucyVan/dsh-side-chat-slash",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucyVan/dsh-side-chat-slash.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bugs": {
    "url": "https://github.com/lucyVan/dsh-side-chat-slash/issues"
  },
  "forkedFrom": {
    "name": "@flyer103/dsh-side-chat",
    "version": "0.7.0",
    "url": "https://github.com/flyer103/dsh-side-chat"
  }
}
